# Server Port
PORT=5000

# Local MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/zipi

# Allowed frontend origins (comma-separated list; must include active Vite origin)
CLIENT_ORIGIN=http://localhost:5174

# Supervisor dashboard / admin API key (for x-admin-key header on /api/admin/*)
ADMIN_KEY=zipi-supervisor-dev-key-change-me

# SMTP configuration for supervisor email notifications (Nodemailer + Gmail)
# For Gmail:
# 1. Turn on 2-Step Verification in your Google Account.
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address in SMTP_USER and the 16-character App Password (no spaces) in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SUPERVISOR_EMAIL=supervisor@zipi.aero

# Set to true to also email a receipt confirmation to the customer (off by default)
SEND_CUSTOMER_CONFIRMATION=false
